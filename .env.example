# Local Face Finder Configuration

# Face Detection Settings
FACE_DETECTION_MODEL=hog  # 'hog' (faster) or 'cnn' (more accurate)
FACE_CLUSTERING_TOLERANCE=0.6  # 0.4-0.7 (lower = stricter matching)
MIN_CLUSTER_SIZE=2

# Image Scanning
SUPPORTED_FORMATS=.jpg,.jpeg,.png,.bmp,.gif,.tiff,.webp
THUMBNAIL_SIZE=200  # pixels
FACE_CROP_SIZE=150  # pixels

# Database
DB_PATH=data/faces.db

# Performance
MAX_IMAGE_SIZE=2000  # Resize large images for faster processing
BATCH_SIZE=100  # Process images in batches
